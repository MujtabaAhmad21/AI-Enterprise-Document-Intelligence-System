# ---- core ----
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- database ----
POSTGRES_USER=didoc
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=didoc
DATABASE_URL=postgresql+psycopg://didoc:REPLACE_ME_DB_PASSWORD@db:5432/didoc

# ---- providers ----
OPENAI_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini

# ---- retrieval (see docs/SEARCH_SPEC.md) ----
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_COSINE=0.30
ANSWER_CONFIDENCE_THRESHOLD=0.50

# ---- auth ----
JWT_SECRET_KEY=REPLACE_ME_WITH_32_PLUS_RANDOM_BYTES
SEED_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
SEED_MEMBER_PASSWORD=REPLACE_ME_MEMBER_PASSWORD

# ---- storage (ADR-018: S3-compatible; MinIO locally) ----
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=http://storage:9000
STORAGE_S3_BUCKET=didoc-documents
STORAGE_S3_ACCESS_KEY=REPLACE_ME_ACCESS_KEY
STORAGE_S3_SECRET_KEY=REPLACE_ME_SECRET_KEY
MINIO_ROOT_USER=REPLACE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD

# ---- retention (ADR-020, ADR-022) ----
DOCUMENT_FILE_RETENTION_DAYS=90
QUESTION_RETENTION_DAYS=365

# ---- frontend (PUBLIC — shipped to the browser) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_BYTES=26214400
